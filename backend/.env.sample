# Backend environment variables — copy to .env and fill in values.

# Postgres connection URLs (three roles, two endpoints)
# See CLAUDE.md §Tenant isolation via Postgres RLS for topology details.
DATABASE_URL=postgresql+psycopg2://polite_app:<password>@<pooler-host>/<dbname>
DATABASE_URL_ADMIN=postgresql+psycopg2://polite_admin:<password>@<direct-host>/<dbname>
DATABASE_URL_MIGRATIONS=postgresql+psycopg2://<owner-user>:<password>@<direct-host>/<dbname>

# Role passwords (used by Alembic RLS migration to (re)apply GRANT/ALTER ROLE)
POLITE_APP_DB_PASSWORD=<polite_app_password>
POLITE_ADMIN_DB_PASSWORD=<polite_admin_password>

# Required only when DATABASE_URL_MIGRATIONS is not explicitly set
# (i.e., Render PR previews). Prod and local-dev set DATABASE_URL_MIGRATIONS directly.
OWNER_DB_USER=neondb_owner
OWNER_DB_PASSWORD=<owner_password>

# Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_JWT_ISSUER=https://<slug>.clerk.accounts.dev

# App
FRONTEND_URL=http://localhost:5173
